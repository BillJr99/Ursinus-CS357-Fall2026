{"version": 2, "width": 100, "height": 30, "title": "Set up an isolated agent project", "code_viz_provenance": "recorded", "duration": 44.108}
[0.0, "m", "Create a project"]
[0.0, "o", "$ mkdir cs357-agent-project && cd cs357-agent-project\r\n"]
[0.0, "o", ""]
[0.101, "m", "Place a file outside"]
[0.101, "o", "$ printf 'Outside the mount\\n' > ../outside-cs357-demo.txt\r\n"]
[0.101, "o", ""]
[0.202, "m", "Copy in the downloads"]
[0.202, "o", "$ cp ../downloads/AgentBox.Dockerfile ../downloads/cs357-agent-box.sh ../downloads/check-agent-box.sh . && ls -1\r\n"]
[0.27, "o", "\u001b[0;0mAgentBox.Dockerfile\u001b[m\r\n\u001b[0;0mcheck-agent-box.sh\u001b[m\r\n\u001b[0;0mcs357-agent-box.sh\u001b[m\r\n"]
[0.303, "m", "Start Git"]
[0.303, "o", "$ git init -q && printf 'A small project\\n' > notes.txt\r\n"]
[0.303, "o", ""]
[0.404, "m", "Save a baseline"]
[0.404, "o", "$ git add . && git -c user.name=Student -c user.email=student@example.invalid commit -qm \"Start the agent project\" && git status --short\r\n"]
[0.404, "o", ""]
[0.505, "m", "Start Herdr and check the box"]
[0.505, "o", "$ BUILDKIT_PROGRESS=plain NO_MODEL=1 bash ../downloads/cs357-agent-box.sh bash ./check-agent-box.sh\r\n"]
[0.633, "o", "=== Building the agent box\r\n"]
