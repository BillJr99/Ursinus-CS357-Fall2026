{"version": 2, "width": 100, "height": 30, "title": "Docker Desktop and the course tools", "code_viz_provenance": "scripted", "duration": 0.005}
[0.0, "m", "Install on your host"]
[0.0, "o", "$ # Install and start Docker Desktop using the tutorial installer and settings.\r\n"]
[0.0, "o", ""]
[0.001, "m", "Verify Docker"]
[0.001, "o", "$ docker run hello-world\r\n"]
[0.001, "o", "Hello from Docker!\nThis message shows that your installation appears to be working correctly.\n"]
[0.002, "m", "Build the course image"]
[0.002, "o", "$ cd ~/cs357-work/.devcontainer && docker compose build\r\n"]
[0.002, "o", "[+] Building\n[+] Building complete\n"]
[0.003, "m", "Enter the course container"]
[0.003, "o", "$ docker compose run --rm cs357\r\n"]
[0.003, "o", "/workspace$\n"]
[0.004, "m", "Check the NLP model"]
[0.004, "o", "$ python3 -c \"import spacy; nlp = spacy.load('en_core_web_sm'); print('spacy OK:', nlp('Agents plan and act.')[0].pos_)\"\r\n"]
[0.004, "o", "spacy OK: NOUN\n"]
