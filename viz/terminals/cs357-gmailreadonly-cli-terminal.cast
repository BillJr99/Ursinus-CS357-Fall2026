{"version": 2, "width": 100, "height": 30, "title": "Gmail read-only: CLI path", "code_viz_provenance": "scripted", "duration": 0.013}
[0.0, "m", "Install the Cloud CLI on Ubuntu or WSL"]
[0.0, "o", "$ sudo apt-get update\nsudo apt-get install ca-certificates curl gnupg\ncurl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg |\nsudo gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg\nprintf '%s\\n' 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' |\nsudo tee /etc/apt/sources.list.d/google-cloud-sdk.list\nsudo apt-get update\nsudo apt-get install google-cloud-cli\ngcloud --version\r\n"]
[0.0, "o", ""]
[0.001, "m", "Sign in to the Cloud CLI"]
[0.001, "o", "$ gcloud auth login --brief\r\n"]
[0.001, "o", ""]
[0.002, "m", "Create a dedicated test project if needed"]
[0.002, "o", "$ read -r -p 'Choose a globally unique Cloud project ID: ' PROJECT_ID\ngcloud projects create \"$PROJECT_ID\" --name='CS357 Gmail Read Test'\r\n"]
[0.002, "o", ""]
[0.003, "m", "Check the Gmail API"]
[0.003, "o", "$ read -r -p 'Test Cloud project ID: ' PROJECT_ID\ngcloud services list --enabled --project=\"$PROJECT_ID\" --filter='config.name=gmail.googleapis.com' --format='value(config.name)'\r\n"]
[0.003, "o", ""]
[0.004, "m", "Enable Gmail only if needed"]
[0.004, "o", "$ gcloud services enable gmail.googleapis.com --project=\"$PROJECT_ID\"\r\n"]
[0.004, "o", ""]
[0.005, "m", "Install the Workspace CLI"]
[0.005, "o", "$ npm install -g @googleworkspace/cli@0.22.5\r\n"]
[0.005, "o", ""]
[0.006, "o", "$ gws --version\r\n"]
[0.006, "o", "gws 0.22.5\nThis is not an officially supported Google product.\n"]
[0.007, "m", "Diagnose a glibc error on Ubuntu 22.04 WSL"]
[0.007, "o", "$ uname -m; getconf GNU_LIBC_VERSION\r\n"]
[0.007, "o", ""]
[0.008, "m", "Verify and replace only the npm package binary"]
[0.008, "o", "$ (\nset -eu\ntest \"$(uname -m)\" = x86_64\nprefix=$(npm prefix -g)\ncase \"$prefix\" in \"${NVM_DIR:-$HOME/.nvm}\"/versions/node/*) ;; *) exit 1 ;; esac\npkg=\"$(npm root -g)/@googleworkspace/cli\"\ntest \"$(node -p 'require(process.argv[1]).version' \"$pkg/package.json\")\" = 0.22.5\ntest \"$(command -v gws)\" = \"$prefix/bin/gws\"\ntest -f \"$pkg/bin/gws\" && test ! -L \"$pkg/bin/gws\"\nwork=$(mktemp -d)\ncd \"$work\"\nasset=google-workspace-cli-x86_64-unknown-linux-musl.tar.gz\nbase=https://github.com/googleworkspace/cli/releases/download/v0.22.5\ncurl -fsSLO \"$base/$asset\"\ncurl -fsSLO \"$base/$asset.sha256\"\nsha256sum --check \"$asset.sha256\"\ntar -xzf \"$asset\" ./gws\n./gws --version\ninstall -m 0755 ./gws \"$pkg/bin/gws\"\ngws --version\n)\r\n"]
[0.008, "o", ""]
[0.009, "m", "Store the Desktop client locally"]
[0.009, "o", "$ export GOOGLE_WORKSPACE_CLI_CONFIG_DIR=\"$HOME/.config/cs357-gmail-readonly\"\nclient_download=\"$HOME/Downloads/client_secret.json\"\ninstall -d -m 700 \"$GOOGLE_WORKSPACE_CLI_CONFIG_DIR\"\n(umask 077; set -C; cat \"$client_download\" > \"$GOOGLE_WORKSPACE_CLI_CONFIG_DIR/client_secret.json\")\r\n"]
[0.009, "o", ""]
[0.01, "m", "Authorize Gmail read-only"]
[0.01, "o", "$ gws auth login --scopes https://www.googleapis.com/auth/gmail.readonly\r\n"]
[0.01, "o", ""]
[0.011, "m", "Inspect the request without calling Gmail"]
[0.011, "o", "$ gws gmail users messages list --dry-run --params '{\"userId\":\"me\",\"q\":\"subject:\\\"CS357 MCP DEMO\\\"\",\"maxResults\":3}'\r\n"]
[0.011, "o", "{\n  \"body\": null,\n  \"dry_run\": true,\n  \"is_multipart_upload\": false,\n  \"method\": \"GET\",\n  \"query_params\": [\n    [\n      \"maxResults\",\n      \"3\"\n    ],\n    [\n      \"q\",\n      \"subject:\\\"CS357 MCP DEMO\\\"\"\n    ]\n  ],\n  \"url\": \"https://gmail.googleapis.com/gmail/v1/users/me/messages\"\n}\n"]
[0.012, "m", "Try the agent"]
[0.012, "o", "$ opencode\r\n"]
[0.012, "o", ""]
