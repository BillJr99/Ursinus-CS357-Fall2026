{"version": 2, "width": 100, "height": 30, "title": "One shared directory in a container", "code_viz_provenance": "recorded", "duration": 45.01}
[0.0, "m", "Prepare the workspace"]
[0.0, "o", "$ mkdir -p iso/workspace && cd iso\r\n"]
[0.0, "o", ""]
[0.001, "o", "$ echo \"Hello from the one host directory this container is allowed to see.\" > workspace/README.txt\r\n"]
[0.001, "o", ""]
[0.002, "m", "Keep a file outside"]
[0.002, "o", "$ echo \"outside the shared directory\" > decoy-secret.txt\r\n"]
[0.002, "o", ""]
[0.003, "m", "Build the demo image"]
[0.003, "o", "$ docker build -t cs357-isolation-demo . && chmod +x run.sh\r\n"]
