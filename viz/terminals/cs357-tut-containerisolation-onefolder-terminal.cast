[41.304, "m", "Check the user"]
[41.304, "o", "$ ./run.sh bash -c 'id'\r\n"]
[41.555, "o", "uid=1000(bun) gid=1000(bun) groups=1000(bun)\r\n"]
[41.705, "m", "Try the read-only filesystem"]
[41.705, "o", "$ ./run.sh bash -c 'touch /etc/x'\r\n"]
[41.953, "o", "touch: cannot touch '/etc/x': Read-only file system\r\n"]
[42.106, "m", "Search for the outside file"]
[42.106, "o", "$ ./run.sh bash -c 'find / -name decoy-secret.txt 2>/dev/null'\r\n"]
[42.106, "o", ""]
[42.707, "m", "Read the shared file"]
[42.707, "o", "$ ./run.sh bash -c 'cat /workspace/README.txt'\r\n"]
[42.947, "o", "Hello from the one host directory this container is allowed to see.\r\n"]
[43.108, "m", "Write through the mount"]
[43.108, "o", "$ ./run.sh bash -c 'echo \"written from inside the container\" > /workspace/from-container.txt'\r\n"]
[43.108, "o", ""]
[43.509, "m", "Check the agent installation"]
[43.509, "o", "$ ./run.sh bash -c 'omp --version'\r\n"]
[44.808, "o", "omp/18.18.1\r\n"]
